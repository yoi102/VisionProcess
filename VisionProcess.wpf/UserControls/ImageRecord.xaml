<UserControl x:Class="VisionProcess.wpf.UserControls.ImageRecord"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisionProcess.wpf.UserControls"
             xmlns:converter="clr-namespace:VisionProcess.wpf.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Record"
             d:Background="Wheat"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converter:MatToBitmapSourceConverter x:Key="MatToBitmapSourceConverter" />
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <ComboBox DisplayMemberPath="Title"
                      DockPanel.Dock="Top"
                      ItemsSource="{Binding ElementName=Record, Path=RecordSource}"
                      SelectedItem="{Binding ElementName=Record, Path=SelectedRecord}"
                      Style="{StaticResource MahApps.Styles.ComboBox}" />
            <local:ImageEx x:Name="image"
                           Title="{Binding ElementName=Record, Path=SelectedRecord.Title}"
                           ImageSource="{Binding ElementName=Record, Path=SelectedRecord.DisplayImage, Converter={StaticResource MatToBitmapSourceConverter}}" />
        </DockPanel>
    </Grid>
</UserControl>