<UserControl x:Class="VisionProcess.wpf.Views.Tools.ImageThresholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ex="clr-namespace:VisionProcess.wpf.Markup"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:opencv="clr-namespace:OpenCvSharp;assembly=OpenCvSharp"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             xmlns:uc="clr-namespace:VisionProcess.wpf.UserControls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:VisionProcess.ViewModel.ViewModels.Tools;assembly=VisionProcess.ViewModel"
             d:Background="Wheat"
             d:DataContext="{d:DesignInstance Type=viewmodels:ImageThresholdViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uc:ImageRecord Grid.Row="0"
                        RecordSource="{Binding Records, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <GroupBox  Grid.Row="1"
                   Header="ImageThresholdView">

            <StackPanel Margin="10,10,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.ThresholdType}}" />
                    <ComboBox Grid.Column="1"
                              Width="150"
                              Margin="3,0,0,0"
                              ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type opencv:ThresholdTypes}}}"
                              SelectedItem="{Binding Inputs.ThresholdType}"
                              Style="{StaticResource MaterialDesignComboBox}" />
                </Grid>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.ThresholdValue}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Maximum="255"
                                       Minimum="0"
                                       Value="{Binding Inputs.ThresholdValue}" />
                </Grid>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MaximumValue}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Maximum="255"
                                       Minimum="0"
                                       Value="{Binding Inputs.MaximumValue}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <ScrollViewer Grid.Row="2"
                      md:ScrollViewerAssist.IsAutoHideEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      ToolTip="{Binding ElementName=textblock, Path=Text}"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="textblock"
                       Text="{Binding RunStatus.Message}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

    </Grid>
</UserControl>
