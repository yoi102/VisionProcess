<UserControl x:Class="VisionProcess.wpf.Views.Tools.AcquireImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             xmlns:uc="clr-namespace:VisionProcess.wpf.UserControls"
             xmlns:viewmodels="clr-namespace:VisionProcess.ViewModel.ViewModels.Tools;assembly=VisionProcess.ViewModel"
             d:Background="Wheat"
             d:DataContext="{d:DesignInstance Type=viewmodels:AcquireImageViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition  Height="300" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <uc:ImageRecord Grid.Row="0"
                        RecordSource="{Binding Records, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <GroupBox  Grid.Row="1"
                   Header="AcquireImageView">

            <StackPanel Grid.Row="1">
                <Button Margin="50"
                        Command="{Binding AcquireLocalImagesCommand}"
                        Content="{I18N {x:Static r:LangKeys.Select}}" />
            </StackPanel>
        </GroupBox>

        <ScrollViewer Grid.Row="2"
                      md:ScrollViewerAssist.IsAutoHideEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      ToolTip="{Binding ElementName=textblock, Path=Text}"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="textblock"
                       Text="{Binding RunStatus.Message}"
                       TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
