<UserControl x:Class="VisionProcess.wpf.Views.Tools.ImageFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ex="clr-namespace:VisionProcess.wpf.Markup"
             xmlns:m="clr-namespace:VisionProcess.Tools.Models;assembly=VisionProcess.Tools"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:opencv="clr-namespace:OpenCvSharp;assembly=OpenCvSharp"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             xmlns:uc="clr-namespace:VisionProcess.wpf.UserControls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VisionProcess.ViewModel.ViewModels.Tools;assembly=VisionProcess.ViewModel"
             d:Background="Wheat"
             d:DataContext="{d:DesignInstance Type=vm:ImageFilterViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="KernelWidthHeightVisibility"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="NormalizedBox">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="Gaussian">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KernelSizeVisibility"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="Median">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SigmaXYVisibility"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="Gaussian">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BilateralVisibility"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="Bilateral">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BorderTypeVisibility"
               TargetType="Grid">
            <Setter Property="Visibility"
                    Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Inputs.FilterType}"
                             Value="Median">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <uc:ImageRecord Grid.Row="0"
                        RecordSource="{Binding Records, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <GroupBox  Grid.Row="1"
                   Header="ImageFilterView">

            <StackPanel Margin="10,10,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.FilterType}}" />
                    <ComboBox Grid.Column="1"
                              Width="150"
                              Margin="3,0,0,0"
                              ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type m:FilterTypes}}}"
                              SelectedItem="{Binding Inputs.FilterType}"
                              Style="{StaticResource MaterialDesignComboBox}" />
                </Grid>
                <Grid VerticalAlignment="Center"
                      Style="{StaticResource BorderTypeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.BorderType}}" />
                    <ComboBox Grid.Column="1"
                              Width="150"
                              Margin="3,0,0,0"
                              ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type opencv:BorderTypes}}}"
                              SelectedItem="{Binding Inputs.BorderType}"
                              Style="{StaticResource MaterialDesignComboBox}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource KernelWidthHeightVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.KernelWidth}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Minimum="1"
                                       Value="{Binding Inputs.KernelWidth}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource KernelWidthHeightVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.KernelHeight}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Minimum="1"
                                       Value="{Binding Inputs.KernelHeight}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource KernelSizeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.KernelSize}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="2"
                                       Minimum="1"
                                       Value="{Binding Inputs.KernelSize}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource SigmaXYVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SigmaX}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Value="{Binding Inputs.SigmaX}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource SigmaXYVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SigmaY}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Value="{Binding Inputs.SigmaY}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource BilateralVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.Diameter}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Value="{Binding Inputs.Diameter}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource BilateralVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SigmaColor}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Value="{Binding Inputs.SigmaColor}" />
                </Grid>

                <Grid VerticalAlignment="Center"
                      Style="{StaticResource BilateralVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SigmaSpace}}" />
                    <mah:NumericUpDown Grid.Column="1"
                                       Width="150"
                                       Margin="3,0,0,0"
                                       HorizontalAlignment="Left"
                                       Interval="1"
                                       Value="{Binding Inputs.SigmaSpace}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <ScrollViewer Grid.Row="2"
                      md:ScrollViewerAssist.IsAutoHideEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      ToolTip="{Binding ElementName=textblock, Path=Text}"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="textblock"
                       Text="{Binding RunStatus.Message}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

    </Grid>
</UserControl>
