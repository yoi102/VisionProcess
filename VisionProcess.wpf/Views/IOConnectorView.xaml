<UserControl x:Class="VisionProcess.wpf.Views.IOConnectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisionProcess.wpf.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VisionProcess.ViewModel.ViewModels;assembly=VisionProcess.ViewModel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cv="clr-namespace:VisionProcess.wpf.Converters"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             d:DataContext="{d:DesignInstance Type=vm:IOConnectorViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <cv:EnumDescriptionConverter x:Key="enumDescriptionConverter" />

    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="4,0,0,0"
                       Text="{I18N {x:Static r:LangKeys.AvailableInputs}}" />
            <TextBlock Margin="0,0,20,0"
                       Text="{Binding InputPortItemCount, StringFormat=: {0}}" />
            <TextBlock Text="{I18N {x:Static r:LangKeys.AvailableOutputs}}" />
            <TextBlock Text="{Binding OutputPortItemCount, StringFormat=: {0}}" />
        </StackPanel>

        <TreeView x:Name="treeView"
                  Grid.Row="1"
                  Margin="0,12"
                  ItemsSource="{Binding TreeNodes}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedItemChanged">
                    <i:InvokeCommandAction Command="{Binding Path=TreeNodeSelectedCommand}"
                                           CommandParameter="{Binding ElementName=treeView, Path=SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}"
                                          ItemsSource="{Binding Path=ChildNodes}">
                    <Grid>
                        <Grid.ToolTip>
                            <StackPanel>
                                <!--如果 StringFormat 用多语言会很麻烦-->
                                <TextBlock Text="{Binding Path=Path,StringFormat=Path：{0}}" />
                                <TextBlock Text="{Binding Path=FullPath,StringFormat=FullPath：{0}}" />
                                <TextBlock Text="{Binding Path=Type,StringFormat=Type：{0}}" />
                                <!--用了StringFormat 不得不用Converter-->
                                <TextBlock Text="{Binding Path=State,StringFormat=State：{0},Converter={StaticResource enumDescriptionConverter}}" />
                                <TextBlock Text="{Binding Path=Value,StringFormat=Value：{0}}" />
                            </StackPanel>
                        </Grid.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Path=Path}" />
                            <TextBlock Margin="10,0,0,0"
                                       Opacity="0.6"
                                       Text="{Binding Path=Type.Name, StringFormat=({0})}" />
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center">
            <Button Content="{I18N {x:Static r:LangKeys.AddToInputs}}"
                    Margin="4"
                    Command="{Binding AddInputCommand}" />
            <Button Content="{I18N {x:Static r:LangKeys.AddAllInputs}}"
                    Margin="4"
                    Command="{Binding AddAllInputsCommand}" />
            <Button Content="{I18N {x:Static r:LangKeys.AddToOutputs}}"
                    Margin="20,4,4,4"
                    Command="{Binding AddOutputCommand}" />
            <Button Content="{I18N {x:Static r:LangKeys.AddAllOutputs}}"
                    Margin="4"
                    Command="{Binding AddAllOutputsCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
