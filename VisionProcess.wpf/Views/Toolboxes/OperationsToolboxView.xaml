<UserControl x:Class="VisionProcess.wpf.Views.Toolboxes.OperationsToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:yr="https://github.com/yoi102/xaml/controls"
             xmlns:models="clr-namespace:VisionProcess.Runtime.Models;assembly=VisionProcess.Runtime"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:local="clr-namespace:VisionProcess.wpf.Views.Toolboxes"
             xmlns:viewmodels="clr-namespace:VisionProcess.ViewModel.ViewModels;assembly=VisionProcess.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>


        <ListBox Margin="3"
                 dd:DragDrop.DropTargetAdornerBrush="Coral"
                 dd:DragDrop.IsDragSource="True"
                 dd:DragDrop.IsDropTarget="True"
                 dd:DragDrop.UseDefaultDragAdorner="True"
                 dd:DragDrop.UseDefaultEffectDataTemplate="True"
                 ItemsSource="{Binding SelectedEditor.Process.Operations}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectedItem="{Binding SelectedEditor.Process.SelectedOperation}"
                 SelectionMode="Single"
                 Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"
                               Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:OperationModel}">
                    <GroupBox Width="200"
                              Height="180"
                              Style="{StaticResource ResourceKey=MaterialDesignCardGroupBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Image Source="{Binding Operator.Records[0].DisplayImage}" />
                            <yr:EditableTextBlock Grid.Row="1"
                                                  Text="{Binding Operator.Name}" />
                        </Grid>
                    </GroupBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


    </Grid>
</UserControl>
