<UserControl x:Class="VisionProcess.wpf.Views.Toolboxes.FolderExplorerToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             xmlns:toolboxes="clr-namespace:VisionProcess.ViewModel.ViewModels.Toolboxes;assembly=VisionProcess.ViewModel"
             xmlns:cm="clr-namespace:VisionProcess.wpf.Helpers"
             xmlns:yr="https://github.com/yoi102/xaml/controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toolboxes:FolderExplorerToolboxViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="320">
    <UserControl.Resources>
        <cm:BindingProxy x:Key="Proxy"
                         DataContext="{Binding}" />
    </UserControl.Resources>


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10,8,10,6"
                   LastChildFill="False">
            <TextBlock Text="{I18N {x:Static r:LangKeys.Documents}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />

            <Button Width="26"
                    Height="26"
                    Padding="0"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="Refresh"
                    DockPanel.Dock="Right">
                <md:PackIcon Kind="Refresh"
                             Width="16"
                             Height="16" />
            </Button>

            <Button Width="26"
                    Height="26"
                    Padding="0"
                    Margin="0,0,4,0"
                    Command="{Binding AddEditorCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="Add Editor"
                    DockPanel.Dock="Right">
                <md:PackIcon Kind="Plus"
                             Width="16"
                             Height="16" />
            </Button>

            <Button Width="26"
                    Height="26"
                    Padding="0"
                    Margin="0,0,4,0"
                    Command="{Binding LoadDocumentCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="Load Document"
                    DockPanel.Dock="Right">
                <md:PackIcon Kind="FolderOpen"
                             Width="16"
                             Height="16" />
            </Button>
        </DockPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Documents}"
                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type toolboxes:FolderExplorerDocumentItemViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="SelectedBorder"
                                Visibility="Hidden"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                CornerRadius="2"
                                Width="2" />

                        <Grid Margin="4,0"
                              ToolTip="{Binding ToolTipText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Save"
                                              Command="{Binding DataContext.SaveDocumentCommand,  Source={StaticResource Proxy}}"
                                              CommandParameter="{Binding}"
                                              Icon="{md:PackIcon Kind=ContentSave, Size=16}" />
                                    <MenuItem Header="Save As"
                                              Command="{Binding DataContext.SaveDocumentAsCommand,  Source={StaticResource Proxy}}"
                                              CommandParameter="{Binding}"
                                              Icon="{md:PackIcon Kind=ContentSaveMove, Size=16}" />
                                    <Separator />
                                    <MenuItem Header="Close"
                                              Command="{Binding DataContext.CloseDocumentCommand,  Source={StaticResource Proxy}}"
                                              CommandParameter="{Binding}"
                                              Icon="{md:PackIcon Kind=Close, Size=16}" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <md:PackIcon Grid.Column="0"
                                         Kind="FileDocumentOutline"
                                         Width="16"
                                         Height="16"
                                         VerticalAlignment="Top"
                                         Margin="0,2,6,0" />

                            <StackPanel Grid.Column="1">
                                <yr:EditableTextBlock Text="{Binding DocumentName, Mode=TwoWay}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding ToolTipText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="SelectedBorder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
