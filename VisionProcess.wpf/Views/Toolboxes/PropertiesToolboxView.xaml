<UserControl x:Class="VisionProcess.wpf.Views.Toolboxes.PropertiesToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:toolboxes="clr-namespace:VisionProcess.ViewModel.ViewModels.Toolboxes;assembly=VisionProcess.ViewModel"
             xmlns:views="clr-namespace:VisionProcess.wpf.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toolboxes:PropertiesToolboxViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="400">
    <Grid>
        <Grid.Resources>
            <md:NullableToVisibilityConverter x:Key="NotNullValueToVisibility"
                                              NotNullValue="Visible"
                                              NullValue="Collapsed" />
        </Grid.Resources>

        <views:OperationView DataContext="{Binding SelectedOperation}"
                             Visibility="{Binding ., Converter={StaticResource NotNullValueToVisibility}}" />
    </Grid>
</UserControl>
