<UserControl x:Class="VisionProcess.wpf.Views.Dialogs.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:r="clr-namespace:VisionProcess.Lang;assembly=VisionProcess.Lang"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisionProcess.wpf.Views.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition MinHeight="30" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock Name="HeaderTextBlock"
                   Margin="0 8 0 8"
                   FontSize="18"
                   FontWeight="Bold"
                   FontStretch="ExtraCondensed" />
        <TextBlock Name="MessageTextBlock"
                   Grid.Row="1"
                   Margin="0 8 0 8"
                   FontStretch="ExtraCondensed" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="2"
                    x:Name="ButtonStackPanel"
                    Margin="0 50 0 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button x:Name="OkButton"
                    Content="{I18N {x:Static r:LangKeys.Ok}}"
                    IsDefault="True"
                    IsCancel="True"
                    Margin="0 0 0 0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static sys:Boolean.TrueString}" />

            <!-- 取消按钮 -->
            <Button x:Name="CancelButton"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    Visibility="Collapsed"
                    IsCancel="True"
                    Margin="0 0 0 0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static sys:Boolean.FalseString}" />


        </StackPanel>
    </Grid>
</UserControl>
