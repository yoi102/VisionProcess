<mah:MetroWindow x:Class="VisionProcess.Views.MainView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                 xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                 xmlns:converter="clr-namespace:VisionProcess.wpf.Converters;assembly=VisionProcess.wpf"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dd="urn:gong-wpf-dragdrop"
                 xmlns:local="clr-namespace:VisionProcess.Views"
                 xmlns:v_tb="clr-namespace:VisionProcess.Views.Toolboxes"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:models="clr-namespace:VisionProcess.Runtime.Models;assembly=VisionProcess.Runtime"
                 xmlns:r="clr-namespace:VisionProcess.Lang.Strings;assembly=VisionProcess.Lang"
                 xmlns:viewmodels="clr-namespace:VisionProcess.Application.ViewModels;assembly=VisionProcess.ViewModel"
                 xmlns:svc="clr-namespace:VisionProcess.ViewModel.ViewServices;assembly=VisionProcess.ViewModel"
                 xmlns:yr="https://github.com/yoi102/xaml/controls"
                 xmlns:cm="clr-namespace:VisionProcess.Core;assembly=VisionProcess.Common"
                 Title="VisionProcess"
                 Width="1400"
                 Height="850"
                 d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
                 mah:ControlsHelper.CornerRadius="0"
                 ResizeMode="CanResizeWithGrip"
                 TitleCharacterCasing="Normal"
                 mc:Ignorable="d">
    <Window.Resources>
        <md:NullableToVisibilityConverter x:Key="NotNullValueToVisibility"
                                          NotNullValue="Visible"
                                          NullValue="Collapsed" />

        <cm:BindingProxy x:Key="Proxy"
                         DataContext="{Binding}" />
    </Window.Resources>

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Content="{md:PackIcon Kind=Github, Size=20}"
                    Click="IconClicked"
                    Width="35"
                    Height="22" />

            <!--<Menu>
                <MenuItem Header="File">
                    <MenuItem Command="{Binding AddEditorCommand}"
                              Header="Add Editor" />
                    <MenuItem Command="{Binding CloseEditorCommand}"
                              Header="Close Editor" />
                </MenuItem>
            </Menu>-->
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <md:DialogHost Style="{StaticResource MaterialDesignEmbeddedDialogHost}"
                   Identifier="{x:Static svc:ViewServiceIdentifiers.RootDialogHost}"
                   Background="{DynamicResource MaterialDesign.Brush.Background}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.Resources>
                <!-- Document data template -->
                <DataTemplate DataType="{x:Type viewmodels:EditorViewModel}">
                    <local:EditorView />
                </DataTemplate>

                <!-- Document header template (tab header with icon + title) -->
                <DataTemplate x:Key="DocumentTabHeaderTemplate">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DrawingBox"
                                     Width="14"
                                     Height="14"
                                     Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>

                
                
                <!-- LayoutItem style selector: different styles for toolboxes vs documents -->
                <local:PanesStyleSelector x:Key="PanesStyleSelector">
                    <local:PanesStyleSelector.ToolboxStyle>
                        <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                             <!--LayoutItem.DataContext is the LayoutItem itself; Model is the LayoutAnchorable (or toolbox VM).--> 
                            <Setter Property="Title"
                                    Value="{Binding Model.Title}" />
                            <Setter Property="ContentId"
                                    Value="{Binding Model.ContentId}" />
                            <Setter Property="ClipToBounds"
                                    Value="True" />
                        </Style>
                    </local:PanesStyleSelector.ToolboxStyle>
                    <local:PanesStyleSelector.DocumentStyle>
                        <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                             <!--LayoutItem.DataContext is the LayoutItem itself; Model is the EditorViewModel.--> 
                            <Setter Property="Title"
                                    Value="{Binding Model.Name}" />
                            <Setter Property="ContentId"
                                    Value="{Binding Model.Id}" />
                        </Style>
                    </local:PanesStyleSelector.DocumentStyle>
                </local:PanesStyleSelector>
            </Grid.Resources>

            <avalonDock:DockingManager x:Name="DockingManager"
                                       Grid.Row="1"
                                       DocumentsSource="{Binding Editors}"
                                       ActiveContent="{Binding SelectedEditor, Mode=TwoWay}"
                                       DocumentClosing="DockingManager_DocumentClosing"
                                       DocumentHeaderTemplate="{StaticResource DocumentTabHeaderTemplate}"
                                       LayoutItemContainerStyleSelector="{StaticResource PanesStyleSelector}">
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutPanel Orientation="Horizontal">
                            <avalonDock:LayoutAnchorablePane DockWidth="200">
                                <avalonDock:LayoutAnchorable Title="{x:Static r:Strings.Documents}"
                                                             CanClose="False"
                                                             CanHide="False">
                                    <v_tb:FolderExplorerToolboxView DataContext="{Binding FolderExplorer}" />
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>

                            <avalonDock:LayoutDocumentPane />

                            <avalonDock:LayoutAnchorablePane DockWidth="320">
                                <avalonDock:LayoutAnchorable Title="{x:Static r:Strings.Property}"
                                                             CanClose="False"
                                                             CanHide="False">
                                    <v_tb:PropertiesToolboxView DataContext="{Binding Properties}" />
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutPanel>

                        <avalonDock:LayoutAnchorablePane DockHeight="250">
                            <avalonDock:LayoutAnchorable Title="{x:Static r:Strings.Operations}"
                                                         CanClose="False"
                                                         CanHide="False">
                                <ListBox Margin="3"
                                         dd:DragDrop.DropTargetAdornerBrush="Coral"
                                         dd:DragDrop.IsDragSource="True"
                                         dd:DragDrop.IsDropTarget="True"
                                         dd:DragDrop.UseDefaultDragAdorner="True"
                                         dd:DragDrop.UseDefaultEffectDataTemplate="True"
                                         ItemsSource="{Binding SelectedEditor.Process.Operations}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectedItem="{Binding SelectedEditor.Process.SelectedOperation}"
                                         SelectionMode="Single"
                                         Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"
                                                       Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:OperationModel}">
                                            <GroupBox Width="200"
                                                      Height="180"
                                                      Style="{StaticResource ResourceKey=MaterialDesignCardGroupBox}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Image Source="{Binding Operator.Records[0].DisplayImage}" />
                                                    <yr:EditableTextBlock Grid.Row="1"
                                                                          Text="{Binding Operator.Name}" />
                                                </Grid>
                                            </GroupBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>
    </md:DialogHost>
</mah:MetroWindow>
